# Backend API (Node/Express + Postgres - see the backend repo)
#
# Local development: leave NEXT_PUBLIC_API_URL unset. Requests to /api/*
# fall back to same-origin and are proxied to BACKEND_URL by the rewrite
# in next.config.js (defaults to http://localhost:4000).
# BACKEND_URL=http://localhost:4000
#
# Production (e.g. Vercel): point this directly at the deployed backend.
# Render issues a normal, publicly trusted certificate here, so no SSL
# errors occur for this URL.
# NEXT_PUBLIC_API_URL=https://backend-resultgen.onrender.com/api

# Appwrite Configuration (legacy - only needed if Appwrite-backed
# features/pages are still in use)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=your_bucket_id_here

# Collection IDs
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
NEXT_PUBLIC_APPWRITE_AUTH_CODES_COLLECTION_ID=auth_codes
NEXT_PUBLIC_APPWRITE_STUDENTS_COLLECTION_ID=students
NEXT_PUBLIC_APPWRITE_RESULTS_COLLECTION_ID=results
NEXT_PUBLIC_APPWRITE_CLASSES_COLLECTION_ID=classes
NEXT_PUBLIC_APPWRITE_SESSIONS_COLLECTION_ID=sessions
